    public function getSettings()
    {
        return response()->json([
            'status' => true,
            'message' => 'Dispatch settings fetched successfully',
            'data' => DispatchSetting::current(),
        ]);
    }

    public function updateSettings(Request $request)
    {
        $settings = DispatchSetting::current();

        $data = $request->validate([
            'auto_dispatch_enabled' => 'nullable|boolean',
            'max_search_radius_miles' => 'nullable|numeric|min:1|max:100',
            'accept_timeout_seconds' => 'nullable|integer|min:5|max:300',
            'driver_batch_size' => 'nullable|integer|min:1|max:20',
            'stale_order_minutes' => 'nullable|integer|min:1|max:120',
            'distance_weight' => 'nullable|integer|min:0|max:100',
            'rating_weight' => 'nullable|integer|min:0|max:100',
            'vehicle_match_weight' => 'nullable|integer|min:0|max:100',
            'acceptance_rate_weight' => 'nullable|integer|min:0|max:100',
            'surge_enabled' => 'nullable|boolean',
            'surge_multiplier' => 'nullable|numeric|min:1|max:5',
            'emergency_stop' => 'nullable|boolean',
            'dispatch_mode' => 'nullable|in:nearest,balanced,rating_priority',
            'max_retry_attempts' => 'nullable|integer|min:1|max:10',
            'driver_reject_cooldown_seconds' => 'nullable|integer|min:30|max:3600',
        ]);

        $settings->fill($data)->save();

        return response()->json([
            'status' => true,
            'message' => 'Dispatch settings updated successfully',
            'data' => $settings->fresh(),
        ]);
    }

    public function emergencyStop()
    {
        $settings = DispatchSetting::current();
        $settings->update([
            'auto_dispatch_enabled' => false,
            'emergency_stop' => true,
        ]);

        return response()->json([
            'status' => true,
            'message' => 'Emergency stop activated',
            'data' => $settings->fresh(),
        ]);
    }


    /**
