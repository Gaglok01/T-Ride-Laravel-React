    public function autoAssign(Request $request)
    {
        $settings = DispatchSetting::current();

        if (!$settings->auto_dispatch_enabled || $settings->emergency_stop) {
            return response()->json([
                'status' => false,
                'message' => 'Auto-dispatch is paused or emergency stop is active.',
                'data' => [
                    'auto_dispatch_enabled' => $settings->auto_dispatch_enabled,
                    'emergency_stop' => $settings->emergency_stop,
                ],
            ], 409);
        }

        $dryRun = (bool) $request->boolean('dry_run', false);

        $pendingResponse = $this->getPendingOrders()->getData(true);
        $driverResponse = $this->getAvailableDrivers()->getData(true);

        $orders = collect($pendingResponse['data'] ?? [])
            ->filter(function ($order) use ($settings) {
                return (int) ($order['wait_minutes'] ?? 0) >= (int) $settings->stale_order_minutes;
            })
            ->take(max(1, (int) $settings->driver_batch_size))
            ->values();

        $drivers = collect($driverResponse['data'] ?? [])
            ->filter(function ($driver) {
                $lat = (float) ($driver['current_lat'] ?? $driver['lat'] ?? 0);
                $lng = (float) ($driver['current_lng'] ?? $driver['lng'] ?? 0);
                return $lat !== 0.0 && $lng !== 0.0;
            })
            ->values();

        $results = [];

        foreach ($orders as $order) {
            $best = $this->bestDispatchDriverForOrder($order, $drivers, $settings);

            if (!$best) {
                $results[] = [
                    'order_id' => $order['order_id'] ?? null,
                    'source_type' => $order['source_type'] ?? null,
                    'source_id' => $order['source_id'] ?? null,
                    'assigned' => false,
                    'message' => 'No eligible driver found inside dispatch radius.',
                ];
                continue;
            }

            if ($dryRun) {
                $results[] = [
                    'order_id' => $order['order_id'] ?? null,
                    'source_type' => $order['source_type'] ?? null,
                    'source_id' => $order['source_id'] ?? null,
                    'assigned' => false,
                    'dry_run' => true,
                    'best_driver_id' => $best['id'],
                    'best_driver_name' => $best['name'] ?? 'Driver',
                    'distance_miles' => round($best['distance_miles'], 2),
                    'score' => round($best['dispatch_score'], 2),
                ];
                continue;
            }

            $assignRequest = new Request([
                'order_type' => $order['source_type'],
                'order_id' => $order['source_id'],
                'driver_id' => $best['id'],
            ]);

            $assignResponse = $this->assignDriver($assignRequest);
            $assignData = $assignResponse->getData(true);

            $results[] = [
                'order_id' => $order['order_id'] ?? null,
                'source_type' => $order['source_type'] ?? null,
                'source_id' => $order['source_id'] ?? null,
                'assigned' => (bool) ($assignData['status'] ?? false),
                'best_driver_id' => $best['id'],
                'best_driver_name' => $best['name'] ?? 'Driver',
                'distance_miles' => round($best['distance_miles'], 2),
                'score' => round($best['dispatch_score'], 2),
                'message' => $assignData['message'] ?? null,
            ];
        }

        return response()->json([
            'status' => true,
            'message' => $dryRun ? 'Auto-dispatch dry run completed.' : 'Auto-dispatch completed.',
            'data' => [
                'settings' => $settings->fresh(),
                'orders_checked' => $orders->count(),
                'drivers_checked' => $drivers->count(),
                'results' => $results,
            ],
        ]);
    }

    private function bestDispatchDriverForOrder($order, $drivers, $settings): ?array
    {
        $pickupLat = (float) ($order['pickup_lat'] ?? $order['lat'] ?? 0);
        $pickupLng = (float) ($order['pickup_lng'] ?? $order['lng'] ?? 0);

        if ($pickupLat === 0.0 || $pickupLng === 0.0) {
            return null;
        }

        $maxRadius = max(1, (float) $settings->max_search_radius_miles);
        $orderType = strtolower((string) ($order['type'] ?? ''));

        $best = null;

        foreach ($drivers as $driver) {
            $driver = (array) $driver;

            $lat = (float) ($driver['current_lat'] ?? $driver['lat'] ?? 0);
            $lng = (float) ($driver['current_lng'] ?? $driver['lng'] ?? 0);

            if ($lat === 0.0 || $lng === 0.0) {
                continue;
            }

            $distanceMiles = $this->dispatchMilesBetween($lat, $lng, $pickupLat, $pickupLng);

            if ($distanceMiles > $maxRadius) {
                continue;
            }

            $rating = min(5, (float) ($driver['rating'] ?? 0));
            $serviceType = strtolower((string) ($driver['service_type'] ?? ''));
            $vehicleType = strtolower((string) ($driver['vehicle_type'] ?? ''));

            $distanceScore = max(0, 100 - (($distanceMiles / $maxRadius) * 100));
            $ratingScore = ($rating / 5) * 100;
            $vehicleScore = ($serviceType === $orderType || $vehicleType === $orderType) ? 100 : 50;
            $acceptanceScore = (float) ($driver['acceptance_rate'] ?? 80);

            $score =
                ($distanceScore * (int) $settings->distance_weight) +
                ($ratingScore * (int) $settings->rating_weight) +
                ($vehicleScore * (int) $settings->vehicle_match_weight) +
                ($acceptanceScore * (int) $settings->acceptance_rate_weight);

            $driver['distance_miles'] = $distanceMiles;
            $driver['dispatch_score'] = $score;

            if (!$best || $driver['dispatch_score'] > $best['dispatch_score']) {
                $best = $driver;
            }
        }

        return $best;
    }

    private function dispatchMilesBetween($lat1, $lng1, $lat2, $lng2): float
    {
        $earthRadiusMiles = 3958.8;

        $dLat = deg2rad($lat2 - $lat1);
        $dLng = deg2rad($lng2 - $lng1);

        $a = sin($dLat / 2) * sin($dLat / 2) +
            cos(deg2rad($lat1)) *
            cos(deg2rad($lat2)) *
            sin($dLng / 2) *
            sin($dLng / 2);

        return $earthRadiusMiles * 2 * atan2(sqrt($a), sqrt(1 - $a));
    }


